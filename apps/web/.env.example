# Supabase → Project Settings → API (or "Connect" → App Frameworks → Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). The legacy "anon" key works here too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Used to build the email-confirmation link. Defaults to the request origin.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
